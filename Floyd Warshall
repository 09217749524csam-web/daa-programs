#include <stdio.h>
 
#define INF 99999
 
int main() {
    int n;
 
    printf("Enter number of vertices: ");
    scanf("%d", &n);
 
    int dist[n][n];
 
    printf("Enter adjacency matrix (use 99999 for INF):\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &dist[i][j]);
        }
    }
 
    // Floyd-Warshall Algorithm
    for (int k = 0; k < n; k++) {
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < n; j++) {
                if (dist[i][k] != INF && dist[k][j] != INF) {
                    if (dist[i][k] + dist[k][j] < dist[i][j]) {
                        dist[i][j] = dist[i][k] + dist[k][j];
                    }
                }
            }
        }
    }
 
    printf("\nAll Pairs Shortest Path Matrix:\\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (dist[i][j] == INF) {
                printf("INF ");
            } else {
                printf("%d ", dist[i][j]);
            }
        }
        printf("\n");
    }
 
    printf("\nTime Complexity: O(V^3) = O(%d^3) = O(%d)\n", n, n * n * n);
    printf("Space Complexity: O(V^2) = O(%d^2) = O(%d)\n", n, n * n);
 
    return 0;
}

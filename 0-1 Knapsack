#include <stdio.h>
 
int max(int a, int b) {
    return (a > b) ? a : b;
}
 
int main() {
    int n, W;
 
    printf("Enter number of items: ");
    scanf("%d", &n);
 
    int weight[n], value[n];
 
    printf("Enter weights of items:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &weight[i]);
    }
 
    printf("Enter values of items:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &value[i]);
    }
 
    printf("Enter knapsack capacity: ");
    scanf("%d", &W);
 
    int dp[n + 1][W + 1];
 
    for (int i = 0; i <= n; i++) {
        for (int w = 0; w <= W; w++) {
            dp[i][w] = 0;
        }
    }
 
    for (int i = 1; i <= n; i++) {
        for (int w = 1; w <= W; w++) {
            if (weight[i - 1] <= w) {
                dp[i][w] = max(
                    value[i - 1] + dp[i - 1][w - weight[i - 1]],
                    dp[i - 1][w]
                );
            } else {
                dp[i][w] = dp[i - 1][w];
            }
        }
    }
 
    printf("\nMaximum Profit: %d\n", dp[n][W]);
    printf("Time Complexity: O(n * W) = O(%d * %d) = O(%d)\n", n, W, n * W);
    printf("Space Complexity: O(n * W) = O(%d * %d) = O(%d)\n", n, W, n * W);
 
    return 0;
}

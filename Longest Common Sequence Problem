#include <stdio.h>
#include <string.h>
 
int max(int a, int b) {
    return (a > b) ? a : b;
}
 
int LCS(char X[], char Y[]) {
    int m = strlen(X);
    int n = strlen(Y);
    int dp[m + 1][n + 1];
 
    for (int i = 0; i <= m; i++) {
        for (int j = 0; j <= n; j++) {
            dp[i][j] = 0;
        }
    }
 
    for (int i = 1; i <= m; i++) {
        for (int j = 1; j <= n; j++) {
            if (X[i - 1] == Y[j - 1]) {
                dp[i][j] = 1 + dp[i - 1][j - 1];
            } else {
                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);
            }
        }
    }
 
    return dp[m][n];
}
 
int main() {
    char X[1000], Y[1000];
 
    printf("Enter first string: ");
    scanf("%999s", X);
 
    printf("Enter second string: ");
    scanf("%999s", Y);
 
    int m = strlen(X);
    int n = strlen(Y);
    int result = LCS(X, Y);
 
    printf("\\nLength of Longest Common Subsequence: %d\\n", result);
    printf("Time Complexity: O(%d * %d) = O(%d)\\n", m, n, m * n);
    printf("Space Complexity: O(%d * %d) = O(%d)\\n", m, n, m * n);
 
    return 0;
}
